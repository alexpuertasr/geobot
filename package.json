{
  "name": "geobot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "sst install",
    "dev": "sst dev",
    "deploy": "sst deploy",
    "test": "sst shell -- playwright test",
    "test:sdk": "vitest run",
    "check": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.36.0",
    "@slack/bolt": "5.1.0",
    "@slack/web-api": "8.3.0",
    "sst": "4.17.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "3.1161.0",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
